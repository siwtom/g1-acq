#!name=G1 Pro Annual Test
#!desc=v7.5.0 兼容入口：引用 G1 ACQ 同一三档脚本，2TB 12个月优惠测试目标 g1.2tb.ai.12months_ip_90p（无 .acq），在原有 /ai? 范围内被动采集，支持最近10次响应/本次新增/重复诊断；当前主模块为 g1-acq-v7.sgmodule，启用一个即可；非主动查询全量 SKU
#!system=ios

[Rule]
# 与旧模块相同：拦截 UDP 443，作用于使用该配置的流量。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/siwtom/g1-acq@main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/siwtom/g1-acq@main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
